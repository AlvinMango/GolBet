@using GolBet.Entities.Enums
@using GolBet.Web.Helpers
@model IEnumerable<GolBet.Services.DTOs.MatchDto>

@{
    ViewData["Title"] = "Partidos";
    var current = (MatchStatus?)ViewBag.CurrentStatus;
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-3">

        <div>
            <h1 class="display-6 fw-bold">Partidos</h1>
            <p class="text-muted mb-0">
                Consulta los partidos disponibles en GolBet.
            </p>
        </div>

        <a asp-action="Create" class="btn btn-success">
            + Nuevo partido
        </a>

    </div>

    <!-- Filtros -->
    <div class="d-flex gap-2 flex-wrap mb-4">

        <a asp-action="Index"
           class="btn btn-sm @(current is null ? "btn-success" : "btn-outline-success")">
            Todos
        </a>

        <a asp-action="Index"
           asp-route-status="@MatchStatus.Scheduled"
           class="btn btn-sm @(current == MatchStatus.Scheduled ? "btn-success" : "btn-outline-success")">
            Programados
        </a>

        <a asp-action="Index"
           asp-route-status="@MatchStatus.InProgress"
           class="btn btn-sm @(current == MatchStatus.InProgress ? "btn-success" : "btn-outline-success")">
            En juego
        </a>

        <a asp-action="Index"
           asp-route-status="@MatchStatus.Finished"
           class="btn btn-sm @(current == MatchStatus.Finished ? "btn-success" : "btn-outline-success")">
            Finalizados
        </a>

    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No hay partidos para el filtro seleccionado.
        </div>
    }
    else
    {
        <div class="row g-4">

            @foreach (var match in Model)
            {
                <div class="col-md-6 col-lg-4">

                    <div class="card h-100 shadow-sm">

                        <!-- Encabezado -->
                        <div class="card-header d-flex justify-content-between align-items-center">

                            <span>
                                📅 @match.Date.ToColombiaTime().ToString("ddd dd MMM · h:mm tt")
                            </span>

                            @switch (match.Status)
                            {
                                case MatchStatus.Scheduled:
                                    <span class="badge bg-primary">
                                        Programado
                                    </span>
                                    break;

                                case MatchStatus.InProgress:
                                    <span class="badge bg-warning text-dark">
                                        En juego
                                    </span>
                                    break;

                                case MatchStatus.Finished:
                                    <span class="badge bg-secondary">
                                        Finalizado
                                    </span>
                                    break;
                            }

                        </div>

                        <!-- Equipos -->
                        <div class="card-body text-center">

                            <div class="d-flex justify-content-around align-items-center">

                                <!-- Local -->
                                <div>

                                    <img src="@(match.HomeTeamCrestUrl ?? "https://placehold.co/60x60/e9ecef/6c757d?text=FC")"
                                         alt="@match.HomeTeamName"
                                         width="60"
                                         height="60"
                                         class="mb-1" />

                                    <div class="fw-bold small">
                                        @match.HomeTeamName
                                    </div>

                                </div>

                                <!-- Resultado -->
                                <div class="px-2">

                                    @if (match.Status == MatchStatus.Finished)
                                    {
                                        <span class="fs-3 fw-bold">
                                            @match.HomeGoals - @match.AwayGoals
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="fs-4 text-muted">
                                            VS
                                        </span>
                                    }

                                </div>

                                <!-- Visitante -->
                                <div>

                                    <img src="@(match.AwayTeamCrestUrl ?? "https://placehold.co/60x60/e9ecef/6c757d?text=FC")"
                                         alt="@match.AwayTeamName"
                                         width="60"
                                         height="60"
                                         class="mb-1" />

                                    <div class="fw-bold small">
                                        @match.AwayTeamName
                                    </div>

                                </div>

                            </div>

                        </div>

                        <!-- Cuotas -->
                        <div class="card-footer">

                            <div class="row g-2 text-center">

                                <div class="col">

                                    <div class="border rounded py-1">

                                        <small class="text-muted d-block">
                                            1 · Local
                                        </small>

                                        <span class="fw-bold">
                                            @match.HomeOdds.ToString("0.00")
                                        </span>

                                    </div>

                                </div>

                                <div class="col">

                                    <div class="border rounded py-1">

                                        <small class="text-muted d-block">
                                            X · Empate
                                        </small>

                                        <span class="fw-bold">
                                            @match.DrawOdds.ToString("0.00")
                                        </span>

                                    </div>

                                </div>

                                <div class="col">

                                    <div class="border rounded py-1">

                                        <small class="text-muted d-block">
                                            2 · Visitante
                                        </small>

                                        <span class="fw-bold">
                                            @match.AwayOdds.ToString("0.00")
                                        </span>

                                    </div>

                                </div>

                            </div>

                            <!-- BOTÓN VER DETALLE -->
                            <a asp-action="Detail"
                               asp-route-id="@match.Id"
                               class="btn btn-sm btn-outline-secondary w-100 mt-2">
                                Ver detalle
                            </a>

                            <!-- BOTÓN EDITAR -->
                            <a asp-action="Edit"
                               asp-route-id="@match.Id"
                               class="btn btn-sm btn-outline-primary w-100 mt-2">
                                Editar
                            </a>

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>